    "@radix-ui/react-tooltip": "^1.1.8",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "lucide-react": "^1.47.0",
    "next": "16.3.8",
    "next-intl": "4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.54.2",
    "sharp": "0.35.5",
    "tailwind-merge": "^2.6.0",
